#!/usr/bin/env python3
"""md-index -- generate docs/index.md and mds/index.md from frontmatter.

Each doc starts with a YAML frontmatter block whose `summary:` is its
index entry, marked when `status: superseded` (with `superseded-by:`
as its link). docs/ is listed alphabetically; mds/ (date-prefixed files
only) newest first, grouped by month. Output is deterministic, so a
rerun changes nothing unless a summary or file changed.

Usage:
    bin/md-index            rewrite both indexes from the working tree
    bin/md-index --staged   same, reading docs from the git index (pre-commit)
    bin/md-index --check    exit 1 if either index is stale, else 0

Run as `python bin/md-index ...` where `python3` is not on the PATH.

Only a small YAML subset is read (stdlib only, no PyYAML): top-level
`key: value` lines, quoted values, and `>`/`>-`/`|` block scalars.
"""
import calendar
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DATE_RE = re.compile(r"^(\d{4})-(\d{2})-\d{2}-.*\.md$")
NOTE = "_Generated by `bin/md-index` from each doc's `summary:` frontmatter; do not edit._"

PREAMBLES = {
    "docs": "# Docs Index\n\n" + NOTE + "\n\nDurable reference: what the system is. "
            "Conventions in [dated-markdown.md](dated-markdown.md).",
    "mds": "# Working Documents Index\n\n" + NOTE + "\n\nDated working documents "
           "capture thinking at a point in time. **Do not assume any document "
           "reflects current implementation**; verify against code and git "
           "history. Conventions in "
           "[../docs/dated-markdown.md](../docs/dated-markdown.md).",
}


def frontmatter(text):
    """Return top-level scalar keys of a leading `---` block as a dict."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}
    out, key, block = {}, None, None
    for line in lines[1:]:
        if line.strip() == "---":
            break
        if block is not None and (line.startswith((" ", "\t")) or not line.strip()):
            block.append(line.strip())
            continue
        if block is not None:
            out[key] = " ".join(x for x in block if x)
            block = None
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val in (">", ">-", "|", "|-"):
            block = []
        else:
            out[key] = val[1:-1] if len(val) > 1 and val[0] == val[-1] and val[0] in "'\"" else val
    if block is not None:
        out[key] = " ".join(x for x in block if x)
    return out


def first_h1(text):
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


class Source:
    """Lists and reads docs from the working tree, or from the git index."""

    def __init__(self, staged):
        self.staged = staged

    def names(self, sub):
        if self.staged:
            out = subprocess.run(["git", "-C", ROOT, "ls-files", "--", sub],
                                 capture_output=True, text=True, check=True).stdout
            return sorted(os.path.basename(p) for p in out.split()
                          if os.path.dirname(p) == sub)
        return sorted(os.listdir(os.path.join(ROOT, sub)))

    def read(self, sub, name):
        if self.staged:
            return subprocess.run(["git", "-C", ROOT, "show", f":{sub}/{name}"],
                                  capture_output=True, text=True, check=True).stdout
        with open(os.path.join(ROOT, sub, name), encoding="utf-8") as f:
            return f.read()


def entry(src, sub, name):
    text = src.read(sub, name)
    fm = frontmatter(text)
    summary = fm.get("summary")
    if not summary:
        sys.stderr.write(f"md-index: warning: {sub}/{name} has no summary\n")
        summary = f"(no summary) {first_h1(text)}".strip()
    if fm.get("status") == "superseded":
        target = fm.get("superseded-by")
        summary = (f"*(superseded by [{target}]({target}))* " if target
                   else "*(superseded)* ") + summary
    return f"- [{name}]({name}) — {summary}"


def render_docs(src):
    names = [n for n in src.names("docs") if n.endswith(".md") and n != "index.md"]
    lines = [PREAMBLES["docs"], ""] + [entry(src, "docs", n) for n in names]
    return "\n".join(lines) + "\n"


def render_mds(src):
    lines, cur = [PREAMBLES["mds"]], None
    for name in sorted((n for n in src.names("mds") if DATE_RE.match(n)), reverse=True):
        m = DATE_RE.match(name)
        ym = (int(m.group(1)), int(m.group(2)))
        if ym != cur:
            cur = ym
            lines += ["", f"## {calendar.month_name[ym[1]]} {ym[0]}", ""]
        lines.append(entry(src, "mds", name))
    return "\n".join(lines) + "\n"


def main(argv):
    mode = argv[1] if len(argv) > 1 else "--write"
    if mode in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    if mode not in ("--write", "--staged", "--check"):
        sys.stderr.write(f"md-index: unknown option {mode} (try -h)\n")
        return 2
    src = Source(staged=(mode == "--staged"))
    stale = False
    for sub, render in (("docs", render_docs), ("mds", render_mds)):
        path = os.path.join(ROOT, sub, "index.md")
        content = render(src)
        try:
            with open(path, encoding="utf-8") as f:
                current = f.read()
        except FileNotFoundError:
            current = None
        if current == content:
            continue
        if mode == "--check":
            sys.stderr.write(f"{sub}/index.md is stale (run: bin/md-index)\n")
            stale = True
        else:
            with open(path, "w", encoding="utf-8") as f:
                f.write(content)
    return 1 if stale else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
